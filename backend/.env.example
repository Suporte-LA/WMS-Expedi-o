PORT=4000

# --- Banco de dados (PostgreSQL local via Docker) ---
DATABASE_URL=postgresql://wms:SENHA_FORTE_AQUI@wms_postgres:5432/wms_expedição
# Para deploy via docker-compose, essas variáveis são usadas pelo container do Postgres:
DB_USER=wms
DB_PASSWORD=SENHA_FORTE_AQUI
DB_NAME=wms_expedição

JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE
JWT_EXPIRES_IN=12h
UPLOADS_DIR=./uploads

# --- Supabase Storage (opcional — sem estas variáveis, uploads salvam localmente) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=wms-images

# Browser origins for cross-origin API requests (comma-separated).
# Same-origin /api requests and server automation do not require this setting.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only set behind a trusted proxy with direct external API access blocked.
# TRUST_PROXY_HOPS=1
