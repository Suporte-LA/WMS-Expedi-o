FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY packages/stock-domain packages/stock-domain
RUN npm ci
COPY backend backend
COPY frontend frontend
RUN npm run build -w backend && npm run build:stock -w frontend
ENV NODE_ENV=development
WORKDIR /app/backend
CMD ["sh","-c","npm run stock:setup -- --seed && node dist/src/server.js"]
