FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY packages/stock-domain packages/stock-domain
RUN npm ci --workspace frontend --include-workspace-root=false
COPY frontend frontend
RUN npm run build:stock -w frontend
FROM nginx:alpine
COPY --from=build /app/frontend/dist-stock /usr/share/nginx/html
COPY deploy/stock.nginx.conf /etc/nginx/conf.d/default.conf
